# 数据库连接（本地上线默认 SQLite 文件，无需修改）
# 部署到 Vercel 等无本地文件系统环境时需改为托管数据库
DATABASE_URL="file:./dev.db"

# NextAuth 加密密钥（必填，用于会话签名）
# 生成方式：npm 环境执行 `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET="generate-a-random-secret-here"

# Resend 邮箱验证码登录（可选，不配置则登录功能不可用）
# 注册 https://resend.com 后在 API Keys 页面创建 key
RESEND_API_KEY=""
RESEND_FROM="MBTI 人格测试 <onboarding@resend.dev>"

# DeepSeek API（AI 深度分析报告，可选但推荐）
# 在 https://platform.deepseek.com 注册并创建 API Key（sk- 开头）
DEEPSEEK_API_KEY=""

# 网站正式域名（部署时必须改为真实域名，如 https://mbti-web.vercel.app）
# 影响 OpenGraph 分享预览、sitemap、canonical 链接
NEXT_PUBLIC_APP_URL="http://localhost:3000"
